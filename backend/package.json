{
  "name": "inquiry-lms-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "test": "tsx --test --env-file-if-exists=.env test/*.test.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "test:watch": "tsx --test --watch --env-file-if-exists=.env test/*.test.ts",
    "lint": "tsc --noEmit",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "check:clerk": "tsx --env-file-if-exists=.env scripts/check-clerk.ts",
    "qa:e2e": "tsx --env-file-if-exists=.env scripts/qa-e2e.ts"
  },
  "dependencies": {
    "@clerk/express": "^1.7.29",
    "@prisma/client": "^6.19.1",
    "adm-zip": "^0.6.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1",
    "multer": "^2.3.0",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "prisma": "^6.19.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
