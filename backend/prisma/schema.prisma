generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  instructor
  learner
}

enum AuditStatus {
  success
  failure
}

enum EnrollmentStatus {
  assigned
  in_progress
  completed
  overdue
}

enum ContentType {
  video
  pdf
  richtext
  scorm
}

enum CompletionStatus {
  incomplete
  completed
  passed
  failed
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum CourseStatus {
  draft
  published
  archived
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  role         Role      @default(learner)
  passwordHash String    @map("password_hash")
  department   String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Set for accounts provisioned by Clerk; null for local password accounts.
  clerkId String? @unique @map("clerk_id")

  courses      Course[]      @relation("CourseOwner")
  auditLogs    AuditLog[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@map("users")
}

/// IMMUTABLE — INSERT ONLY. Never update or delete rows here; BSFI compliance
/// depends on this trail surviving the records it describes.
model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String?     @map("resource_type")
  resourceId   String?     @map("resource_id")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  status       AuditStatus @default(success)
  errorMessage String?     @map("error_message")
  details      Json?
  /// Correlates a trail entry with the request log line that produced it.
  requestId    String?     @map("request_id")
  timestamp    DateTime    @default(now())

  @@index([userId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}

model Course {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  category       String?
  ownerId        String?      @map("owner_id") @db.Uuid
  owner          User?        @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status         CourseStatus @default(draft)
  isMandatory    Boolean      @default(false) @map("is_mandatory")
  complianceType String?      @map("compliance_type")
  targetAudience String?      @map("target_audience")
  version        Int          @default(1)
  difficulty     Difficulty   @default(beginner)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  enrollments   Enrollment[]
  certificates  Certificate[]
  content       CourseContent[]
  scormPackages ScormPackage[]

  @@index([status, ownerId])
  @@index([category])
  @@map("courses")
}

/// Who has been assigned what, and how far they got. The compliance metrics
/// (completion rate, at-risk counts) are all derived from this table.
model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String           @map("course_id") @db.Uuid
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(assigned)
  progress    Int              @default(0)
  /// Seconds of study time reported by the player; drives the progress view.
  timeSpent   Int              @default(0) @map("time_spent")
  dueAt       DateTime?        @map("due_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  lessonCompletions LessonCompletion[]
  scormTracking     ScormTracking[]
  scormSessions     ScormSession[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([status, dueAt])
  @@map("enrollments")
}

/// One item in a course: a video, a PDF, a rich-text page, or a SCORM package.
model CourseContent {
  id          String      @id @default(uuid()) @db.Uuid
  courseId    String      @map("course_id") @db.Uuid
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentType ContentType @map("content_type")
  title       String
  description String?
  /// Set for video, pdf and scorm items.
  fileUrl     String?     @map("file_url")
  /// Set for richtext items.
  contentText String?     @map("content_text")
  orderIndex  Int         @map("order_index")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@unique([courseId, orderIndex])
  @@index([courseId])
  @@map("course_content")
}

/// Records that a learner finished one content item.
model LessonCompletion {
  id           String     @id @default(uuid()) @db.Uuid
  enrollmentId String     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  contentId    String     @map("content_id") @db.Uuid
  completedAt  DateTime   @default(now()) @map("completed_at")

  @@unique([enrollmentId, contentId])
  @@index([enrollmentId])
  @@map("lesson_completions")
}

/// An uploaded and validated SCORM package, extracted under var/scorm/<id>.
model ScormPackage {
  id           String   @id @default(uuid()) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  version      String
  /// Path of the launch file inside the extracted package.
  entryPoint   String   @map("entry_point")
  /// Typical duration declared by the manifest, in seconds.
  duration     Int?
  manifest     Json
  originalName String   @map("original_name")
  sizeBytes    Int      @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  sessions ScormSession[]
  tracking ScormTracking[]

  @@index([courseId])
  @@map("scorm_packages")
}

/// One launch of a package by one learner; the token authorises tracking posts.
model ScormSession {
  id             String       @id @default(uuid()) @db.Uuid
  scormPackageId String       @map("scorm_package_id") @db.Uuid
  scormPackage   ScormPackage @relation(fields: [scormPackageId], references: [id], onDelete: Cascade)
  enrollmentId   String       @map("enrollment_id") @db.Uuid
  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  token          String       @unique
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([enrollmentId])
  @@map("scorm_sessions")
}

/// Rolled-up xAPI results for one learner on one package.
model ScormTracking {
  id               String           @id @default(uuid()) @db.Uuid
  enrollmentId     String           @map("enrollment_id") @db.Uuid
  enrollment       Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  scormPackageId   String           @map("scorm_package_id") @db.Uuid
  scormPackage     ScormPackage     @relation(fields: [scormPackageId], references: [id], onDelete: Cascade)
  learnerId        String           @map("learner_id") @db.Uuid
  score            Int?
  completionStatus CompletionStatus @default(incomplete) @map("completion_status")
  timeSpentSeconds Int              @default(0) @map("time_spent_seconds")
  /// Raw cmi.interactions equivalents, appended as statements arrive.
  interactions     Json             @default("[]")
  lastAccessedAt   DateTime         @default(now()) @map("last_accessed_at")

  @@unique([enrollmentId, scormPackageId])
  @@index([learnerId])
  @@map("scorm_tracking")
}

/// Issued on completion. expiresAt drives the 'certificates expiring soon' metric.
model Certificate {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String    @map("course_id") @db.Uuid
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime? @map("expires_at")

  @@index([expiresAt])
  @@index([userId])
  @@map("certificates")
}
