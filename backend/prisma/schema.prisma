generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  instructor
  learner
}

enum AuditStatus {
  success
  failure
}

enum EnrollmentStatus {
  assigned
  in_progress
  completed
  overdue
}

enum CourseStatus {
  draft
  published
  archived
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  role         Role      @default(learner)
  passwordHash String    @map("password_hash")
  department   String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Set for accounts provisioned by Clerk; null for local password accounts.
  clerkId String? @unique @map("clerk_id")

  courses      Course[]      @relation("CourseOwner")
  auditLogs    AuditLog[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@map("users")
}

/// IMMUTABLE — INSERT ONLY. Never update or delete rows here; BSFI compliance
/// depends on this trail surviving the records it describes.
model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String?     @map("resource_type")
  resourceId   String?     @map("resource_id")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  status       AuditStatus @default(success)
  errorMessage String?     @map("error_message")
  details      Json?
  /// Correlates a trail entry with the request log line that produced it.
  requestId    String?     @map("request_id")
  timestamp    DateTime    @default(now())

  @@index([userId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}

model Course {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  category       String?
  ownerId        String?      @map("owner_id") @db.Uuid
  owner          User?        @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status         CourseStatus @default(draft)
  isMandatory    Boolean      @default(false) @map("is_mandatory")
  complianceType String?      @map("compliance_type")
  targetAudience String?      @map("target_audience")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([status, ownerId])
  @@map("courses")
}

/// Who has been assigned what, and how far they got. The compliance metrics
/// (completion rate, at-risk counts) are all derived from this table.
model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String           @map("course_id") @db.Uuid
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(assigned)
  progress    Int              @default(0)
  dueAt       DateTime?        @map("due_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([status, dueAt])
  @@map("enrollments")
}

/// Issued on completion. expiresAt drives the 'certificates expiring soon' metric.
model Certificate {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String    @map("course_id") @db.Uuid
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime? @map("expires_at")

  @@index([expiresAt])
  @@index([userId])
  @@map("certificates")
}
