{
  "name": "inquiry-lms-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "test": "tsx --test --env-file-if-exists=.env test/server.test.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@clerk/express": "^1.7.29",
    "@prisma/client": "^6.19.1",
    "express": "^5.1.0",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.1",
    "prisma": "^6.19.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
